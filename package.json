{
  "name": "pos-delipostresturbaco",

  "version": "4.9.6",
  "description": "Sistema POS offline-first para Delipostres Turbaco",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env APP_ENV=production nodemon --legacy-watch --ext js,html,css --exec electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac --arm64",
    "build-mac": "electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.delipostres.pos",
    "productName": "POSDelipostresTurbaco",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS Delipostres Turbaco"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon_mac.png"
    },
    "dmg": {
      "background": null,
      "backgroundColor": "#ffffff",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "**/*",
      "!node_modules/*",
      "!config.json",
      "!.env*"
    ],
    "asar": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  }
}
